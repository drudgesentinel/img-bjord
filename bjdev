#!/usr/bin/env raku

my constant $CONTAINER = 'imageboard-pg';
my constant $IMAGE     = 'docker.io/library/postgres:16';

sub db-mode() returns Str {
    (%*ENV<BJORD_DB_MODE> // 'podman').lc
}

sub using-external-db() returns Bool {
    db-mode() eq 'external'
}

sub require-database-url() returns Str {
    my $url = %*ENV<DATABASE_URL> // '';
    if !$url.trim {
        note "DATABASE_URL is required when BJORD_DB_MODE=external";
        exit 1;
    }
    $url.trim
}

sub run-app-psql(Str $sql) {
    if using-external-db() {
        my $url = require-database-url();
        run-or-die <psql>, $url, < -v ON_ERROR_STOP=1 -c >, $sql;
    } else {
        ensure-db-up();
        run-or-die <podman exec -i>, $CONTAINER,
            <psql -U postgres -d imageboard -v ON_ERROR_STOP=1>,
            "-c", $sql;
    }
}

sub apply-schema(Str $url) {
    run-or-die <psql>, $url, < -v ON_ERROR_STOP=1 -f >, 'db/schema.sql';
}

sub prompt-secret(Str $message --> Str) {
    print $message;
    $*OUT.flush;

    my $hide = run <stty -echo>, :out, :err;
    my $secret = $*IN.get // '';
    my $restore = run <stty echo>, :out, :err;

    # move to next line after hidden input
    say '';

    return $secret;
}

# the colon implies it's a named parameter, not positional
sub run-or-die(*@cmd, :$ok-exitcodes = (0)) {
    my $proc = run |@cmd;
    unless $proc.exitcode ∈ $ok-exitcodes {
        note "Command failed: {@cmd.join(' ')}";
        note "Exit code: {$proc.exitcode}";
        exit $proc.exitcode;
    }
    $proc
}

sub container-exists() returns Bool {
    my $p = run <podman container exists>, $CONTAINER;
    $p.exitcode == 0
}

sub container-running() returns Bool {
    my $p = run <podman inspect -f {{.State.Running}}>, $CONTAINER, :out, :err;
    return False unless $p.exitcode == 0;
    # "run" doesn't capture output unless we pipe; simplest is to use exit code + start logic.
    # We'll just attempt start and ignore "already started" cases elsewhere.
    True
}

sub ensure-db-up() {
    if container-exists() {
        # Start it if it's stopped. If it's already running, podman start exits 0 too.
        run-or-die <podman start>, $CONTAINER;
    } else {
        my @cmd =  <
            podman run --rm -d
            --name imageboard-pg
            -p 5432:5432
            -e POSTGRES_PASSWORD=postgres
            -e POSTGRES_DB=imageboard
        >;
        @cmd.push($IMAGE);
        run-or-die @cmd;
    }
}

sub wait-for-db(:$timeout = 10) {
    say "waiting for postgres to be ready...";
    for 1..$timeout -> $i {
        my $p = run <podman exec>, $CONTAINER, <pg_isready -U postgres>, :out, :err;
        if $p.exitcode == 0 {
            say "postgres is ready.";
            return;
        }
        sleep 1;
    }
    note "postgres did not become ready within {$timeout}s";
    exit 1;
}

multi MAIN('db', $cmd) {
    given $cmd {
        when any <up start> {
            if using-external-db() {
                my $app-url = require-database-url();
                say "BJORD_DB_MODE=external: applying schema to DATABASE_URL";
                apply-schema($app-url);

                my $test-url = %*ENV<TEST_DATABASE_URL> // %*ENV<TEST_DATABASE> // %*ENV<DATABASE_URL_TEST> // '';
                if $test-url.trim {
                    say "BJORD_DB_MODE=external: applying schema to TEST_DATABASE_URL";
                    apply-schema($test-url.trim);
                }
            } else {
                say "bringing up postgres (podman)";

                ensure-db-up();
                wait-for-db();

                say "applying schema to app database";
                run-or-die <./scripts/db-init.sh>, "imageboard";

                say "applying schema to test database";
                run-or-die <./scripts/db-init.sh>, "imageboard_test";
            }
        }
        # The :ok-exitcodes(0,125) bit is there because Podman commonly returns 125 when a container
        # doesn’t exist / can’t be operated on. This makes down/nuke “no-op safe”.
        # by this i mean it does nothing if the container state is already what we want
        when any <down stop> {
            if using-external-db() {
                say "BJORD_DB_MODE=external: no container to stop";
            } else {
                say "stopping postgres container (if running)";
                # ok if it's already stopped / missing
                run-or-die <podman stop>, $CONTAINER, :ok-exitcodes(0, 125);
            }
        }

        when any <nuke delete> {
            if using-external-db() {
                say "BJORD_DB_MODE=external: no container to delete";
            } else {
                say "deleting postgres container (if exists)";
                run-or-die <podman rm -f>, $CONTAINER, :ok-exitcodes(0, 125);
            }
        }

        default {
            note "Unknown db command: $cmd";
            exit 1;
        }
    }
}
multi MAIN('admin', $cmd, $name?) {
    given $cmd {
        #this is named stupidly, but manually creates the first admin user
        when any <create-admin-user cau> {
            my $username = $name // prompt "Admin username: ";
            my $password = prompt-secret("Admin password: ");
            $username = $username.trim;
            if !$username || !$password {
                note "Username and password are required";
                exit 1;
            }

            my $escaped-username = $username.subst("'", "''", :g);
            my $escaped-password = $password.subst("'", "''", :g);

            run-app-psql("INSERT INTO users (username, password_hash, is_approved, is_admin) VALUES ('{$escaped-username}', crypt('{$escaped-password}', gen_salt('bf')), true, true);");
        }
        when any <create-user cu> {
            my $username = $name // prompt "Username: ";
            my $password = prompt-secret("Password: ");
            $username = $username.trim;
            if !$username || !$password {
                note "Username and password are required";
                exit 1;
            }

            my $escaped-username = $username.subst("'", "''", :g);
            my $escaped-password = $password.subst("'", "''", :g);

            run-app-psql("INSERT INTO users (username, password_hash) VALUES ('{$escaped-username}', crypt('{$escaped-password}', gen_salt('bf')));");
        }
        when any <approve a> {
            my $target = $name // prompt "Username or user id to approve: ";
            $target = $target.trim;
            if !$target {
                note "Username or user id is required";
                exit 1;
            }

            my $escaped-target = $target.subst("'", "''", :g);

            run-app-psql("UPDATE users SET is_approved = true WHERE username = '{$escaped-target}' OR id::text = '{$escaped-target}';");

            run-app-psql("SELECT id, username, is_approved, activation_code FROM users WHERE username = '{$escaped-target}' OR id::text = '{$escaped-target}';");
        }

        when any <promote p> {
            my $target-username = $name // prompt "Username to promote: ";
            $target-username = $target-username.trim;
            if !$target-username {
                note "Username is required";
                exit 1;
            }

            my $escaped-username = $target-username.subst("'", "''", :g);

            run-app-psql("UPDATE users SET is_admin = true WHERE username = '{$escaped-username}';");

            run-app-psql("SELECT username, is_admin FROM users WHERE username = '{$escaped-username}';");
        }

        when any <rename rn> {
            my $target = $name // prompt "Current username or user id: ";
            my $new-username = prompt "New username: ";

            $target = $target.trim;
            $new-username = $new-username.trim;

            if !$target || !$new-username {
                note "Both current username/user id and new username are required";
                exit 1;
            }

            if $target eq $new-username {
                note "New username must be different from current username/user id";
                exit 1;
            }

            my $escaped-target = $target.subst("'", "''", :g);
            my $escaped-new = $new-username.subst("'", "''", :g);

            run-app-psql("INSERT INTO consumed_usernames (username) VALUES ('{$escaped-new}') ON CONFLICT (username) DO NOTHING;");

            run-app-psql("UPDATE users SET username = '{$escaped-new}' WHERE username = '{$escaped-target}' OR id::text = '{$escaped-target}';");

            run-app-psql("SELECT id, username, is_approved, is_admin FROM users WHERE username = '{$escaped-new}';");
        }

        when any <password-reset pr> {
            my $target = $name // prompt "Username or user id to reset password: ";
            my $new-password = prompt-secret("New password: ");

            $target = $target.trim;

            if !$target || !$new-password {
                note "Both username/user id and new password are required";
                exit 1;
            }

            my $escaped-target = $target.subst("'", "''", :g);
            my $escaped-password = $new-password.subst("'", "''", :g);

            run-app-psql("UPDATE users SET password_hash = crypt('{$escaped-password}', gen_salt('bf')) WHERE username = '{$escaped-target}' OR id::text = '{$escaped-target}';");

            run-app-psql("SELECT id, username, is_approved, is_admin FROM users WHERE username = '{$escaped-target}' OR id::text = '{$escaped-target}';");
        }

        when any <board makeboard> {
            my $slug = prompt "Board slug (e.g. 'b'): ";
            my $board-name = $name // prompt "Board name (e.g. 'Random'): ";
            $slug = $slug.trim;
            $board-name = $board-name.trim;
            if !$slug || !$board-name {
                note "Both slug and name are required";
                exit 1;
            }

            my $escaped-slug = $slug.subst("'", "''", :g);
            my $escaped-name = $board-name.subst("'", "''", :g);

            run-app-psql("INSERT INTO boards (slug, name) VALUES ('{$escaped-slug}', '{$escaped-name}');");
        }

        default {
            note "Unknown admin command: $cmd";
            exit 1;
        }
    }
}
multi MAIN('app', $cmd) {
    given $cmd{
        when any <start> {
            run-or-die("nvm use --lts");
            run-or-die("npm run dev");
            run-or-die("cd frontend && npm run dev");
        }
    }
}