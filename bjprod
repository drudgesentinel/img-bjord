#!/usr/bin/env raku

my constant $DEFAULT_ENV_FILE = '/etc/bjord/bjord.env';
my constant $DEFAULT_APP_DIR  = '/opt/img-bjord/';

sub run-or-die(*@cmd) {
    my $proc = run |@cmd;
    if $proc.exitcode != 0 {
        note "Command failed: {@cmd.join(' ')}";
        note "Exit code: {$proc.exitcode}";
        exit $proc.exitcode;
    }
}

sub parse-env-line(Str $line, Int $line-number, Str $path) {
    my $trimmed = $line.trim;
    return Nil if $trimmed eq '' || $trimmed.starts-with('#');

    if $trimmed.starts-with('export ') {
        $trimmed = $trimmed.substr(7).trim;
    }

    my $eq-pos = $trimmed.index('=');
    if $eq-pos !~~ Int || $eq-pos < 1 {
        note "Skipping malformed line {$line-number} in {$path}";
        return Nil;
    }

    my $key = $trimmed.substr(0, $eq-pos).trim;
    my $value = $trimmed.substr($eq-pos + 1).trim;

    if $value.chars >= 2 {
        my $first = $value.substr(0, 1);
        my $last = $value.substr($value.chars - 1, 1);
        if ($first eq '"' && $last eq '"') || ($first eq "'" && $last eq "'") {
            $value = $value.substr(1, $value.chars - 2);
        }
    }

    $key => $value;
}

sub load-env-file(Str $path --> Hash) {
    my $file = $path.IO;
    if !$file.e {
        note "Env file not found: {$path}";
        exit 1;
    }

    my %vars;
    for $file.lines.kv -> $idx, $line {
        my $entry = parse-env-line($line, $idx + 1, $path);
        next unless $entry.defined;
        %vars{$entry.key} = $entry.value;
    }

    %vars;
}

sub require-database-url(Str $env-file --> Str) {
    my %vars = load-env-file($env-file);
    my $url = %vars<DATABASE_URL> // '';

    if !$url.trim {
        note "DATABASE_URL is missing or empty in {$env-file}";
        exit 1;
    }

    $url.trim;
}

sub schema-path(Str $app-dir --> Str) {
    $app-dir.IO.add('db/schema.sql').absolute.Str;
}

sub apply-schema(Str $database-url, Str $app-dir) {
    my $schema-path = schema-path($app-dir);
    my $schema = $schema-path.IO;
    if !$schema.e {
        note "Schema file not found: {$schema-path}";
        exit 1;
    }

    say "Applying schema from {$schema-path}";
    run-or-die <psql>, $database-url, < -v ON_ERROR_STOP=1 -f >, $schema-path;
    say "Schema migration complete.";
}

multi MAIN('migrate', Str :$env-file = $DEFAULT_ENV_FILE, Str :$app-dir = $DEFAULT_APP_DIR) {
    my $database-url = require-database-url($env-file);
    apply-schema($database-url, $app-dir);
}

multi MAIN('show-url', Str :$env-file = $DEFAULT_ENV_FILE) {
    say require-database-url($env-file);
}

multi MAIN('help') {
    say 'Usage:';
    say '  ./bjprod migrate [--env-file=/etc/bjord/bjord.env] [--app-dir=/opt/img-bjord/]';
    say '  ./bjprod show-url [--env-file=/etc/bjord/bjord.env]';
}

multi MAIN() {
    MAIN('help');
}
