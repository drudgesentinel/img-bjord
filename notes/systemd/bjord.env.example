# Copy to /etc/bjord/bjord.env and chmod 600
# Replace all placeholder values.

# --- Core ---
DATABASE_URL=postgres://bjord_app:REPLACE_ME@127.0.0.1:5432/bjord
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
NODE_ENV=production

# --- Session store ---
SESSION_TABLE_NAME=user_sessions
SESSION_PRUNE_INTERVAL_SECONDS=86400
# SESSION_STORE=memory

# --- Upload/media ---
MEDIA_STORAGE_DRIVER=local
UPLOAD_DIR=/var/lib/bjord/uploads
TEMP_UPLOAD_DIR=/var/lib/bjord/tmp-uploads
UPLOAD_PUBLIC_PREFIX=/api/uploads
MAX_IMAGE_UPLOAD_BYTES=104857600
AVIF_QUALITY=50
AVIF_EFFORT=4

# --- Optional diagnostics ---
# DEBUG=false
# AUTH_DEBUG=false
# CSRF_PROTECTION=true

# --- Optional DB pool tuning ---
# PGPOOL_MAX=10
# PGPOOL_IDLE_TIMEOUT_MS=30000
# PGPOOL_CONN_TIMEOUT_MS=5000
