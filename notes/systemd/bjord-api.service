[Unit]
Description=Bjord API (Express)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=bjord
Group=bjord
WorkingDirectory=/opt/img-bjord
EnvironmentFile=/etc/bjord/bjord.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/img-bjord/src/index.js
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/bjord

# Optional hardening knobs (enable after verifying runtime needs):
# ProtectKernelTunables=true
# ProtectControlGroups=true
# RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
