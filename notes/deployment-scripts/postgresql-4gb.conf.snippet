# PostgreSQL baseline for a 4GB VPS
# Merge into your postgresql.conf (paths differ by distro/version)

# Connectivity
listen_addresses = '127.0.0.1'
port = 5432

# Memory
shared_buffers = 1GB
effective_cache_size = 3GB
work_mem = 8MB
maintenance_work_mem = 256MB

# Connections
max_connections = 80

# WAL / checkpoints
wal_level = replica
checkpoint_completion_target = 0.9
min_wal_size = 1GB
max_wal_size = 4GB

# Planner (SSD VPS)
random_page_cost = 1.1
effective_io_concurrency = 200

# Logging
log_min_duration_statement = 500ms
log_checkpoints = on
log_connections = on
log_disconnections = on
